<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Play 版：不自己下载安装更新，不用无线调试授权，不用设备管理 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:node="remove" />
    <application>
        <receiver android:name=".AdminReceiver" tools:node="remove" />
        <receiver android:name=".PairReceiver" tools:node="remove" />
    </application>
</manifest>
