<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_bg_warm" android:padding="14dp">
    <ImageView android:id="@+id/ring" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitCenter" android:adjustViewBounds="true" android:layout_gravity="center"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:gravity="center_horizontal" android:orientation="vertical">
        <TextView android:id="@+id/big" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—" android:textColor="#3D3530" android:textSize="30sp" android:textStyle="bold"/>
        <TextView android:id="@+id/small" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="分钟可用" android:textColor="#A39589" android:textSize="11sp"/>
    </LinearLayout>
</FrameLayout>
